# Kopieer naar .env (staat in .gitignore). In GitHub Actions als repository-geheimen.

# Copernicus Marine, gratis account: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Vercel, voor publiceren vanuit GitHub Actions (vanaf M4)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optioneel, terugval voor getij (FES2022 via pyTMD)
AVISO_USERNAME=
AVISO_PASSWORD=
